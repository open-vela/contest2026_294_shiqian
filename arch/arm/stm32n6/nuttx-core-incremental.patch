diff --git a/arch/arm/src/arm_m/arm_vectors.c b/arch/arm/src/arm_m/arm_vectors.c
index 1cb785c3fb4..6f2b1fedded 100644
--- a/arch/arm/src/arm_m/arm_vectors.c
+++ b/arch/arm/src/arm_m/arm_vectors.c
@@ -74,10 +74,30 @@ extern void __start(void);
 
 static void start(void)
 {
+#if defined(CONFIG_ARCH_CHIP_STM32N647X0)
+  /* DIAG v5: LED0 ON via the SECURE GPIOG BSRR alias (0x56021818,
+   * BR10=bit26).  MUST use the secure alias: the FSBL leaves the GPIO
+   * pins in their reset SECURE state (no ConfigPinAttributes call), and
+   * a write to the NS alias of a secure peripheral SecureFaults, which
+   * previously made the board look like the jump itself failed.  This is
+   * a pure "did the CPU reach start()" probe: if LED0 never lights, the
+   * FSBL->NuttX jump itself failed (CPU never reached start()). */
+  *(volatile uint32_t *)0x56021818UL = (1UL << 26);
+#endif
+
   /* Set MSP & PSP to the value at reset */
 
   arm_initialize_stack();
 
+#if defined(CONFIG_ARCH_CHIP_STM32N647X0)
+  /* DIAG v5: LED1 ON via the SECURE GPIOE BSRR alias (0x56021018,
+   * BR10=bit26) => arm_initialize_stack() returned without faulting.
+   *   LED0 ON + LED1 OFF -> arm_initialize_stack() faulted (hang).
+   *   LED0 ON + LED1 ON  -> start()+arm_initialize_stack() OK; the hang is
+   *     in __start()/__start_c(). */
+  *(volatile uint32_t *)0x56021018UL = (1UL << 26);
+#endif
+
   /* Zero lr to mark the end of backtrace */
 
   asm volatile ("mov lr, %0\n\t"
diff --git a/arch/arm/src/armv8-m/arm_cache.c b/arch/arm/src/armv8-m/arm_cache.c
index f6e26e78c68..4199e0e4de1 100644
--- a/arch/arm/src/armv8-m/arm_cache.c
+++ b/arch/arm/src/armv8-m/arm_cache.c
@@ -584,19 +584,11 @@ void up_disable_dcache(void)
       uint32_t tmpways;
     } locals;
 
-  /* Disable the D-Cache */
-
-  locals.ccr = getreg32(NVIC_CFGCON);
-  locals.ccr &= ~NVIC_CFGCON_DC;
-  putreg32(locals.ccr, NVIC_CFGCON);
-  UP_MB();
-
-  /* Clean and invalidate the local variable cache. */
-
-  up_flush_dcache((uintptr_t)&locals, (uintptr_t)&locals + sizeof(locals));
-  UP_MB();
-
-  /* Get the characteristics of the D-Cache */
+  /* Get the characteristics of the D-Cache
+   *
+   * NOTE: the clean+invalidate below runs while the D-Cache is still
+   * ENABLED (see the note next to the disable at the end of this function).
+   */
 
   locals.ccsidr = getreg32(NVIC_CCSIDR);
   locals.sets   = CCSIDR_SETS(locals.ccsidr);          /* (Number of sets) - 1 */
@@ -636,6 +628,32 @@ void up_disable_dcache(void)
 
   UP_MB();
 
+  /* Clean and invalidate the local variable cache. */
+
+  up_flush_dcache((uintptr_t)&locals, (uintptr_t)&locals + sizeof(locals));
+  UP_MB();
+
+  /* Disable the D-Cache
+   *
+   * NOTE: this MUST be the last step of the sequence.  Cache maintenance
+   * operations are not guaranteed to be performed once the cache has been
+   * disabled, so flushing after the disable silently drops every value that
+   * was only held in the cache.
+   *
+   * Observed on STM32N6 (2026-09-11): stm32n6_sdmmc_initialize() calls
+   * up_disable_dcache() during boot.  With the old disable-first order the
+   * NuttX heap bookkeeping never reached SRAM and the very next malloc()
+   * (board_bringup -> register_blockdriver -> inode_alloc -> zalloc ->
+   * mm_malloc) asserted on an inconsistent free list.  The same dropped
+   * updates appeared later as random mm.h:354 assertions (cam_save, LVGL,
+   * task spawn).
+   */
+
+  locals.ccr = getreg32(NVIC_CFGCON);
+  locals.ccr &= ~NVIC_CFGCON_DC;
+  putreg32(locals.ccr, NVIC_CFGCON);
+  UP_MB();
+
   l2cc_disable();
 }
 #endif /* CONFIG_ARMV8M_DCACHE */
